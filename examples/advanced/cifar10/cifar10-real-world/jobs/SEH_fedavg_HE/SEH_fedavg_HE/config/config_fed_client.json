{
    "format_version": 2,
    "AGGREGATION_EPOCHS": 2,
    "executors": [
        {
            "tasks": [
                "train",
                "submit_model",
                "validate"
            ],
            "executor": {
                "id": "Executor",
                "path": "nvflare.app_opt.sklearn.sklearn_executor.SKLearnExecutor",
                "args": {
                    "learner_id": "linear_learner"
                }
            }
        }
    ],
    "task_result_filters": [
        {
            "tasks": [
                "train"
            ],
            "filters": [
                {
                    "name": "HEModelEncryptor",
                    "args": {
                        "weigh_by_local_iter": true
                    }
                }
            ]
        },
        {
            "tasks": [
                "submit_model"
            ],
            "filters": [
                {
                    "name": "HEModelEncryptor",
                    "args": {
                        "weigh_by_local_iter": false
                    }
                }
            ]
        }
    ],
    "task_data_filters": [
        {
            "tasks": [
                "train",
                "validate"
            ],
            "filters": [
                {
                    "name": "HEModelDecryptor",
                    "args": {}
                }
            ]
        }
    ],
    "components": [
        {
            "id": "linear_learner",
            "path": "assets.learners.learner_HE.LinearLearner",
            "args": {
                "aggregation_epochs": "{AGGREGATION_EPOCHS}",
                "lr": 0.0001
            }
        },
        {
            "id": "analytic_sender",
            "name": "AnalyticsSender",
            "args": {
                "event_type": "analytix_log_stats"
            }
        },
        {
            "id": "tb_analytics_receive",
            "name": "TBAnalyticsReceiver",
            "args": {
                "events": [
                    "analytix_log_stats"
                ]
            }
        },
        {
            "id": "event_to_fed",
            "name": "ConvertToFedEvent",
            "args": {
                "events_to_convert": [
                    "analytix_log_stats"
                ],
                "fed_event_prefix": "fed."
            }
        }
    ]
}